---
import { CONFIG, isTelegramConfigured } from '../config';

const baseUrl = import.meta.env.BASE_URL;
const homeUrl = baseUrl;
const privacyUrl = `${baseUrl}privacy/`;
const featuresUrl = `${baseUrl}#features`;
const howItWorksUrl = `${baseUrl}#how-it-works`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand-col">
      <a href={homeUrl} class="footer-logo">
        <img src={`${baseUrl}favicon.svg`} alt="" width="24" height="24" />
        <span class="footer-name">JiraNotifyer</span>
      </a>
      <p class="footer-desc">
        {CONFIG.PRODUCT_DESCRIPTION}
      </p>
      <div class="footer-disclaimer">
        JiraNotifyer является независимым проектом и не связан с компанией Atlassian.
      </div>
      <div class="footer-copy">
        &copy; {currentYear} JiraNotifyer. Все права защищены.
      </div>
    </div>

    <div class="footer-nav-col">
      <div class="footer-nav-group">
        <div class="footer-group-title">Навигация</div>
        <a href={featuresUrl} class="footer-link">Возможности</a>
        <a href={howItWorksUrl} class="footer-link">Как работает</a>
        <a href={privacyUrl} class="footer-link">Политика конфиденциальности</a>
      </div>

      <div class="footer-nav-group">
        <div class="footer-group-title">Ресурсы</div>
        <a
          href={CONFIG.GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          GitHub репозиторий
        </a>
        {isTelegramConfigured ? (
          <a
            href={CONFIG.TELEGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            Telegram канал
          </a>
        ) : (
          <span class="footer-link-disabled">
            Telegram (скоро)
          </span>
        )}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    padding: 48px 0 36px;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .footer-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    max-width: 440px;
    line-height: 1.5;
  }

  .footer-disclaimer {
    font-size: 12px;
    color: var(--color-text-subtle);
    line-height: 1.4;
    padding-top: 4px;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--color-text-subtle);
    padding-top: 8px;
  }

  .footer-nav-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .footer-nav-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-group-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 4px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  .footer-link:hover {
    color: var(--color-text-main);
  }

  .footer-link-disabled {
    font-size: 14px;
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
