---
const baseUrl = import.meta.env.BASE_URL;
const homeUrl = baseUrl;
const privacyUrl = `${baseUrl}privacy/`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-info">
      <div class="footer-logo">
        <img src={`${baseUrl}favicon.svg`} alt="JiraNotifyer Logo" width="24" height="24" />
        <span class="footer-brand">JiraNotifyer</span>
      </div>
      <p class="footer-desc">
        Быстрое и надежное браузерное расширение для мгновенных звуковых уведомлений о задачах в Jira.
      </p>
      <p class="footer-copy">
        © {currentYear} JiraNotifyer. Все права защищены.
      </p>
    </div>

    <div class="footer-links">
      <div class="link-group">
        <h4 class="link-group-title">Проект</h4>
        <a href={homeUrl} class="footer-link">Главная</a>
        <a href={privacyUrl} class="footer-link">Политика конфиденциальности</a>
        <a
          href="https://github.com/RusGameHack/jiranotifyer-site"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          GitHub репозиторий
        </a>
      </div>
      <div class="link-group">
        <h4 class="link-group-title">Безопасность</h4>
        <p class="footer-note">
          Расширение работает локально в браузере и не передает учетные данные третьим лицам.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-surface-border);
    background-color: var(--color-surface);
    padding: 3rem 0 2rem;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .footer-brand {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-main);
  }

  .footer-desc {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    max-width: 380px;
  }

  .footer-copy {
    color: var(--color-text-subtle);
    font-size: 0.75rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .link-group-title {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .footer-link {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    transition: color var(--transition-normal);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-note {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
