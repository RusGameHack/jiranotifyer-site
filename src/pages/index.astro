---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExtensionMockup from '../components/ExtensionMockup.astro';
import { CONFIG, isChromeWebStorePublished } from '../config';

const baseUrl = import.meta.env.BASE_URL;
const privacyUrl = `${baseUrl}privacy/`;
---

<BaseLayout
  title="Уведомления о задачах Jira"
  description="JiraNotifyer следит за назначениями, статусами и комментариями к задачам в Jira. Звуковые оповещения и локальная работа без сторонних серверов."
>
  <Header />

  <main>
    <!-- 1. Hero Section (Two-column layout) -->
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="hero-content">
          <h1 class="hero-title">
            Изменения в Jira &mdash; без постоянных проверок
          </h1>
          <p class="hero-subtitle">
            JiraNotifyer следит за назначениями, статусами и комментариями к задачам. Когда происходит важное событие, расширение показывает уведомление и может воспроизвести выбранный вами звук.
          </p>

          <div class="hero-actions">
            {isChromeWebStorePublished ? (
              <a
                href={CONFIG.CHROME_WEB_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Установить JiraNotifyer
              </a>
            ) : (
              <button
                type="button"
                class="btn btn-primary js-open-install-modal"
              >
                Установить JiraNotifyer
              </button>
            )}
            <a href="#how-it-works" class="btn btn-secondary">
              Как это работает
            </a>
          </div>

          <div class="hero-meta">
            <span class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Локальная обработка в браузере
            </span>
            <span class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Сессия вашей Jira
            </span>
          </div>
        </div>

        <div class="hero-preview">
          <ExtensionMockup initialTab="main" interactive={true} />
        </div>
      </div>
    </section>

    <!-- 2. Возможности (Features) -->
    <section id="features" class="section features-section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">Возможности расширения</h2>
          <p class="section-desc">
            Инструменты для своевременного реагирования на задачи без отвлечения от рабочего процесса.
          </p>
        </div>

        <!-- 2 Large Feature Blocks -->
        <div class="feature-large-grid">
          <div class="feature-large-card">
            <div class="feature-large-content">
              <div class="feature-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              </div>
              <h3 class="feature-large-title">Уведомления о задачах и настраиваемый звук</h3>
              <p class="feature-large-text">
                Отслеживание назначения новых задач, смены статусов и комментариев. Вы можете использовать стандартный звуковой сигнал или загрузить собственный аудиофайл в формате MP3, WAV или OGG.
              </p>
              <ul class="feature-checklist">
                <li>Моментальные системные уведомления браузера</li>
                <li>Загрузка своего аудиофайла любого типа</li>
                <li>Возможность отключения звука одним переключателем</li>
              </ul>
            </div>
            <div class="feature-large-visual">
              <div class="visual-sound-card">
                <div class="visual-sound-row">
                  <div class="visual-sound-name">clean-chime.mp3</div>
                  <span class="visual-tag">Активный звук</span>
                </div>
                <div class="visual-sound-bars" aria-hidden="true">
                  <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
              </div>
            </div>
          </div>

          <div class="feature-large-card">
            <div class="feature-large-content">
              <div class="feature-icon-box">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </div>
              <h3 class="feature-large-title">Фоновая синхронизация и статус подключения</h3>
              <p class="feature-large-text">
                Расширение периодически опрашивает настроенный адрес Jira через фоновый Service Worker браузера. На панели всегда виден статус последней проверки и количество найденных задач.
              </p>
              <ul class="feature-checklist">
                <li>Настраиваемый период проверки (от 30 секунд)</li>
                <li>Индикатор соединения в реальном времени</li>
                <li>Кнопка ручной внеочередной проверки</li>
              </ul>
            </div>
            <div class="feature-large-visual">
              <div class="visual-status-card">
                <div class="visual-status-head">
                  <span class="status-indicator-live"></span>
                  <span class="visual-status-title">Синхронизация активна</span>
                </div>
                <div class="visual-status-data">
                  <div>
                    <span class="visual-meta-k">Интервал:</span>
                    <span class="visual-meta-v">60 сек</span>
                  </div>
                  <div>
                    <span class="visual-meta-k">Последний опрос:</span>
                    <span class="visual-meta-v">только что</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Compact Sub-features -->
        <div class="feature-sub-grid">
          <div class="sub-feature-card">
            <div class="sub-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h4 class="sub-title">Удобное расписание</h4>
            <p class="sub-text">
              Задайте интервал рабочего дня (например, с 09:00 до 18:00), чтобы звуковые оповещения не беспокоили вас в нерабочее время.
            </p>
          </div>

          <div class="sub-feature-card">
            <div class="sub-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <h4 class="sub-title">Сессия браузера</h4>
            <p class="sub-text">
              Не нужно передавать логин и пароль: расширение использует уже открытую сессию Jira в вашем браузере.
            </p>
          </div>

          <div class="sub-feature-card">
            <div class="sub-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </div>
            <h4 class="sub-title">Персональная статистика</h4>
            <p class="sub-text">
              Сводка по закрытым и переоткрытым задачам. Модуль находится в активной разработке, показатели являются предварительными.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Демонстрация интерфейса (Interface Showcase) -->
    <section class="section showcase-section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">Интерфейс расширения</h2>
          <p class="section-desc">
            Компактное всплывающее окно со всеми настройками прямо в панели инструментов браузера.
          </p>
        </div>

        <div class="showcase-wrapper">
          <ExtensionMockup initialTab="main" interactive={true} />
        </div>
      </div>
    </section>

    <!-- 4. Как начать работу (Getting Started) -->
    <section id="how-it-works" class="section steps-section">
      <div class="container">
        <div class="section-heading">
          <h2 class="section-title">Как начать работу</h2>
          <p class="section-desc">
            Простая настройка в три последовательных шага без необходимости регистрировать сторонние аккаунты.
          </p>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number" aria-hidden="true">1</div>
            <h3 class="step-title">Установите расширение</h3>
            <p class="step-text">
              Добавьте JiraNotifyer в браузер из Chrome Web Store или загрузите распакованное расширение для режима разработчика.
            </p>
          </div>

          <div class="step-card">
            <div class="step-number" aria-hidden="true">2</div>
            <h3 class="step-title">Укажите адрес Jira</h3>
            <p class="step-text">
              Введите URL вашего инстанса Jira (например, https://jira.company.example). Расширение подхватит авторизованную браузерную сессию.
            </p>
          </div>

          <div class="step-card">
            <div class="step-number" aria-hidden="true">3</div>
            <h3 class="step-title">Настройте оповещения</h3>
            <p class="step-text">
              Выберите период проверки, загрузите желаемый аудиосигнал и при необходимости задайте рабочие часы для тихих периодов.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Конфиденциальность (Privacy Overview) -->
    <section class="section privacy-section">
      <div class="container">
        <div class="privacy-box">
          <div class="privacy-content-left">
            <h2 class="privacy-title">Ваши данные &mdash; под вашим контролем</h2>
            <p class="privacy-lead">
              Мы придерживаемся прозрачной и проверяемой архитектуры: расширение взаимодействует только с вашей Jira и работает локально.
            </p>
            <ul class="privacy-facts">
              <li>
                <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Прямые запросы: расширение обращается непосредственно к настроенному вами инстансу Jira</span>
              </li>
              <li>
                <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Локальное хранилище: данные задач и метрики хранятся на вашем устройстве</span>
              </li>
              <li>
                <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Настройки в chrome.storage.sync могут синхронизироваться стандартными средствами Chrome</span>
              </li>
              <li>
                <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Отсутствуют сторонние трекеры, аналитика и передача задач разработчику</span>
              </li>
            </ul>
            <div class="privacy-action">
              <a href={privacyUrl} class="btn btn-secondary">
                Читать полную Политику конфиденциальности &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FAQ Section -->
    <section class="section faq-section">
      <div class="container faq-container">
        <div class="section-heading">
          <h2 class="section-title">Часто задаваемые вопросы</h2>
          <p class="section-desc">
            Ответы на ключевые вопросы об устройстве и работе расширения.
          </p>
        </div>

        <div class="faq-list">
          <details class="faq-item" open>
            <summary class="faq-question">
              Как подключить Jira?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Достаточно открыть вкладку «Основные» во всплывающем окне расширения и указать базовый URL вашей системы (например, https://jira.yourcompany.com). Расширение проверит доступность и начнет мониторинг.
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              Нужно ли вводить пароль?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Нет, пароль вводить не требуется. Расширение использует стандартные cookie авторизованной сессии Jira, уже открытой в вашем браузере.
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              Можно ли использовать собственный звук?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Да. На вкладке «Общие» можно нажать кнопку «Выбрать файл» и загрузить любой аудиофайл в формате MP3, WAV или OGG. Файл сохраняется локально в памяти расширения.
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              Работают ли уведомления вне рабочего времени?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Вы можете настроить тихие часы на вкладке «Уведомления». При включении опции «Ограничение по времени» звуковые сигналы будут воспроизводиться строго в указанном временном диапазоне (например, с 09:00 до 18:00).
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              Где хранятся данные?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Все данные сохраняются локально в хранилище вашего профиля Chrome (chrome.storage.local и chrome.storage.sync). Никакие серверы разработчика или промежуточные базы данных не используются.
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              Доступна ли статистика?
              <svg class="faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer">
              Вкладка статистики доступна в расширении, однако модуль находится в активной разработке. Отображаемые показатели носят предварительный характер и уточняются по мере доработки алгоритмов.
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- 7. Final Call to Action -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-card">
          <h2 class="cta-title">Начните отслеживать задачи без постоянного переключения вкладок</h2>
          <p class="cta-subtitle">
            Установите JiraNotifyer и получайте мгновенные звуковые сигналы при изменениях в Jira.
          </p>
          <div class="cta-actions">
            {isChromeWebStorePublished ? (
              <a
                href={CONFIG.CHROME_WEB_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Установить JiraNotifyer
              </a>
            ) : (
              <button
                type="button"
                class="btn btn-primary js-open-install-modal"
              >
                Установить JiraNotifyer
              </button>
            )}
            <a href={privacyUrl} class="btn btn-secondary">
              Политика конфиденциальности
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Sections common layout */
  .section {
    padding: 80px 0;
  }

  .section-heading {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 600;
    color: var(--color-text-main);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }

  .section-desc {
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Hero Section */
  .hero-section {
    padding: 72px 0 80px;
    background: #FFFFFF;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    max-width: 580px;
  }

  .hero-title {
    font-size: 48px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-main);
    margin-bottom: 20px;
  }

  .hero-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .meta-item svg {
    color: var(--color-primary);
  }

  .hero-preview {
    display: flex;
    justify-content: center;
  }

  /* Features: 2 Large Cards */
  .features-section {
    background: var(--color-bg-subtle);
  }

  .feature-large-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .feature-large-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    box-shadow: var(--shadow-sm);
  }

  .feature-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .feature-large-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .feature-large-text {
    font-size: 15px;
    color: var(--color-text-body);
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .feature-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text-body);
  }

  .feature-checklist li {
    position: relative;
    padding-left: 20px;
  }

  .feature-checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .feature-large-visual {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .visual-sound-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .visual-sound-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .visual-sound-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-main);
  }

  .visual-tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    background: #E2E8F0;
