---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';

const baseUrl = import.meta.env.BASE_URL;
const privacyUrl = `${baseUrl}privacy/`;
---

<BaseLayout
  title="Официальный сайт"
  description="JiraNotifyer — умное браузерное расширение для мгновенных звуковых уведомлений при назначении задач в Jira."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container hero-container">
        <div class="badge hero-badge">Официальный сайт расширения</div>
        <h1 class="hero-title">
          Не пропускайте важные задачи в <span class="text-gradient">Jira</span>
        </h1>
        <p class="hero-subtitle">
          JiraNotifyer воспроизводит настраиваемый звуковой сигнал и показывает всплывающее уведомление в момент,
          когда задача назначается на вас или изменяется её статус.
        </p>

        <div class="hero-actions" id="install">
          <a
            href="https://chromewebstore.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Установить для Chrome
          </a>
          <a href={privacyUrl} class="btn btn-secondary">
            Политика конфиденциальности
          </a>
        </div>
      </div>
    </section>

    <!-- Key Features Preview -->
    <section class="features-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Ключевые возможности</h2>
          <p class="section-subtitle">
            Простое, легкое и приватное решение для эффективной командной работы.
          </p>
        </div>

        <div class="features-grid">
          <FeatureCard
            icon="🔔"
            title="Звуковые сигналы"
            description="Различные звуковые темы для назначений и обновлений статусов, чтобы моментально реагировать на работу."
          />
          <FeatureCard
            icon="🔒"
            title="Конфиденциальность"
            description="Никаких внешних серверов. Расширение опрашивает только вашу корпоративную Jira через текущую браузерную сессию."
          />
          <FeatureCard
            icon="⚙️"
            title="Гибкая настройка"
            description="Настройка интервала опроса, фильтров проектов, отключения в нерабочее время и громкости сигналов."
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-section {
    padding: 5rem 0 4rem;
    text-align: center;
    background: radial-gradient(circle at 50% 20%, rgba(0, 82, 204, 0.25) 0%, transparent 70%);
  }

  .hero-container {
    max-width: 820px;
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, #4c9aff 0%, #00b8d9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .features-section {
    padding: 4rem 0 5rem;
    border-top: 1px solid var(--color-surface-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 840px) {
    .hero-title {
      font-size: 2.25rem;
    }
    .hero-subtitle {
      font-size: 1.05rem;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
